TUBEVAULT_DATA_DIR=./data
TUBEVAULT_HOST=127.0.0.1
TUBEVAULT_PORT=8765
# Set a long unique password before first launch. Never commit your .env.
TUBEVAULT_PASSWORD=
TUBEVAULT_CLIENT_SECRET=./data/client_secret.json
TUBEVAULT_ALLOWED_HOSTS=localhost,127.0.0.1
TUBEVAULT_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
